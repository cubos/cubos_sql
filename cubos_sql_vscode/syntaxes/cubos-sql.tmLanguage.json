{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "inline.sql.cubos-sql",
  "injectionSelector": "L:source.rust",
  "patterns": [
    {
      "comment": "Match query! macro with a regular string literal as the second argument",
      "name": "meta.embedded.sql.cubos-sql",
      "begin": "(?x)\n  \\b query! \\s*\n  \\( \\s*\n  [^,]+ , \\s*\n  (\")\n",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.string.begin.sql.cubos-sql" }
      },
      "end": "(\")",
      "endCaptures": {
        "1": { "name": "punctuation.definition.string.end.sql.cubos-sql" }
      },
      "contentName": "meta.embedded.sql",
      "patterns": [
        { "include": "#spread-param" },
        { "include": "#named-param" },
        { "include": "source.sql" }
      ]
    },
    {
      "comment": "Match query! macro with a raw string literal r#\"...\"# as the second argument",
      "name": "meta.embedded.sql.cubos-sql",
      "begin": "(?x)\n  \\b query! \\s*\n  \\( \\s*\n  [^,]+ , \\s*\n  (r\\#*\")\n",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.string.begin.sql.cubos-sql" }
      },
      "end": "(\"\\#*)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.string.end.sql.cubos-sql" }
      },
      "contentName": "meta.embedded.sql",
      "patterns": [
        { "include": "#spread-param" },
        { "include": "#named-param" },
        { "include": "source.sql" }
      ]
    }
  ],
  "repository": {
    "spread-param": {
      "comment": "Matches $..identifier and optionally $..identifier { field1, field2 }",
      "name": "variable.spread.cubos-sql",
      "match": "\\$\\.\\.([a-zA-Z_][a-zA-Z0-9_]*)(\\s*\\{[^}]*\\})?"
    },
    "named-param": {
      "comment": "Matches $identifier (but not $..identifier which is handled above)",
      "name": "variable.parameter.cubos-sql",
      "match": "\\$(?!\\.\\.)([a-zA-Z_][a-zA-Z0-9_]*)"
    }
  }
}
