{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "inline.sql.pgsafe",
  "injectionSelector": "L:source.rust",
  "patterns": [
    {
      "comment": "Match sql! macro invocation (single and multi-line)",
      "begin": "\\bsql!\\s*\\(",
      "end": "\\)",
      "patterns": [
        {
          "comment": "Raw string literal containing SQL",
          "name": "meta.embedded.sql.pgsafe",
          "begin": "(r\\#*\")",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.string.begin.sql.pgsafe" }
          },
          "end": "(\"\\#*)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.sql.pgsafe" }
          },
          "contentName": "meta.embedded.sql",
          "patterns": [
            { "include": "#spread-param" },
            { "include": "#named-param" },
            { "include": "source.sql" }
          ]
        },
        {
          "comment": "Regular string literal containing SQL",
          "name": "meta.embedded.sql.pgsafe",
          "begin": "(\")",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.string.begin.sql.pgsafe" }
          },
          "end": "(\")",
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.sql.pgsafe" }
          },
          "contentName": "meta.embedded.sql",
          "patterns": [
            { "include": "#spread-param" },
            { "include": "#named-param" },
            { "include": "source.sql" }
          ]
        }
      ]
    }
  ],
  "repository": {
    "spread-param": {
      "comment": "Matches $..identifier and optionally $..identifier { field1, field2 }",
      "name": "variable.spread.pgsafe",
      "match": "\\$\\.\\.([a-zA-Z_][a-zA-Z0-9_]*)(\\s*\\{[^}]*\\})?"
    },
    "named-param": {
      "comment": "Matches $identifier (but not $..identifier which is handled above)",
      "name": "variable.parameter.pgsafe",
      "match": "\\$(?!\\.\\.)([a-zA-Z_][a-zA-Z0-9_]*\\??)"
    }
  }
}
